{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leones.local/schemas/runtime-execution.v1.schema.json",
  "title": "LEONES runtime-execution.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "execution_id",
    "timestamp_start",
    "timestamp_end",
    "model",
    "protocol",
    "runtime",
    "hardware",
    "command",
    "result",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "runtime-execution.v1"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp_start": {
      "type": "string",
      "format": "date-time"
    },
    "timestamp_end": {
      "type": "string",
      "format": "date-time"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_protocol_id",
        "context",
        "output_token_limit",
        "temperature",
        "warmup_iterations",
        "measurement_iterations"
      ],
      "properties": {
        "prompt_protocol_id": {"type": "string", "minLength": 1},
        "prompt_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "context": {"type": "integer", "minimum": 1},
        "output_token_limit": {"type": "integer", "minimum": 1},
        "temperature": {"type": "number"},
        "top_p": {"type": ["number", "null"]},
        "seed": {"type": ["integer", "null"]},
        "warmup_iterations": {"type": "integer", "minimum": 0},
        "measurement_iterations": {"type": "integer", "minimum": 1}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "binary", "binary_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "binary": {"type": "string", "minLength": 1},
        "binary_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "os", "kernel", "architecture", "cpu"],
      "properties": {
        "host": {"type": "string"},
        "os": {"type": "string"},
        "kernel": {"type": "string"},
        "architecture": {"type": "string"},
        "cpu": {"type": "string"},
        "cpu_threads": {"type": ["integer", "null"], "minimum": 1},
        "physical_cores": {"type": ["integer", "null"], "minimum": 1},
        "ram_total_mb": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "wall_seconds"],
      "properties": {
        "exit_code": {"type": "integer"},
        "wall_seconds": {"type": ["number", "null"], "minimum": 0},
        "maximum_rss_kb": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_log", "evidence"],
      "properties": {
        "raw_log": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  }
}
