{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robertosantosx2.github.io/LEONES/schemas/result.schema.json",
  "title": "LEONES Experiment Result",
  "type": "object",
  "required": ["schema_version", "status", "hardware", "model", "inference", "lotb"],
  "properties": {
    "schema_version": {"type": "string"},
    "status": {"enum": ["reported", "reproducible", "verified", "rejected"]},
    "evidence": {"$ref": "evidence.schema.json"},
    "hardware": {"$ref": "#/$defs/hardware"},
    "model": {"$ref": "#/$defs/model"},
    "inference": {"$ref": "#/$defs/inference"},
    "lotb": {"type": "object", "properties": {"B01": {"$ref": "#/$defs/task"}, "B02": {"$ref": "#/$defs/task"}, "B03": {"$ref": "#/$defs/task"}, "B04": {"$ref": "#/$defs/task"}, "B05": {"$ref": "#/$defs/task"}}, "additionalProperties": false},
    "software": {"type": "object", "additionalProperties": {"type": "string"}},
    "notes": {"type": "string"},
    "agentic": {"$ref": "#/$defs/agentic"}
  },
  "$defs": {
    "hardware": {
      "type": "object",
      "required": ["ram_gb", "os"],
      "properties": {
        "profile": {"enum": ["H0", "H1", "H2", "H3"]},
        "cpu": {"type": "string"},
        "architecture": {"type": "string"},
        "cores": {"type": "integer", "minimum": 1},
        "threads": {"type": "integer", "minimum": 1},
        "ram_gb": {"type": "number", "exclusiveMinimum": 0},
        "gpu": {"type": "string"},
        "vram_gb": {"type": "number", "minimum": 0},
        "os": {"type": "string"},
        "memory_bandwidth_gbps": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "format": {"type": "string"},
        "quantization": {"type": "string"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string"},
        "revision": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "inference": {
      "type": "object",
      "properties": {
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
        "completion_tokens": {"type": ["integer", "null"], "minimum": 0},
        "generation_tokens_per_second": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["completed", "failed", "error", "not_run"]},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "error": {"type": "string"}
      },
      "additionalProperties": false
    },
    "agentic": {
      "type": "object",
      "properties": {
        "benchmark_id": {"type": "string"},
        "benchmark_version": {"type": "string"},
        "task_id": {"type": "string"},
        "task_version": {"type": "string"},
        "execution_id": {"type": "string"},
        "model_version": {"type": ["string", "null"]},
        "runtime": {"type": "object", "additionalProperties": {"type": "string"}},
        "scaffold": {"type": "object", "additionalProperties": {"type": "string"}},
        "environment": {"type": "object", "additionalProperties": {"type": "string"}},
        "tools": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "outcome": {"$ref": "#/$defs/outcome"},
        "trajectory": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "metrics": {"$ref": "#/$defs/agentic_metrics"},
        "safety": {"type": "object", "additionalProperties": true},
        "artifacts": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "grader": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "properties": {
        "status": {"enum": ["success", "partial", "failed", "error", "unknown"]},
        "score": {"type": ["number", "null"]},
        "details": {"type": "string"}
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["model", "tool_call", "tool_result", "error", "recovery", "artifact", "grader", "other"]},
        "timestamp": {"type": ["string", "null"]},
        "name": {"type": ["string", "null"]},
        "duration_seconds": {"type": ["number", "null"], "minimum": 0},
        "status": {"type": ["string", "null"]},
        "details": {"type": ["object", "null"], "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "agentic_metrics": {
      "type": "object",
      "properties": {
        "elapsed_seconds": {"type": ["number", "null"], "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "tool_calls": {"type": ["integer", "null"], "minimum": 0},
        "tool_errors": {"type": ["integer", "null"], "minimum": 0},
        "recovery_count": {"type": ["integer", "null"], "minimum": 0},
        "cost": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
