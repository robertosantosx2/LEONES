{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leones.ia/schemas/evidence-storage-v1.json",
  "title": "LEONES Evidence Storage Contract v1",
  "type": "object",
  "required": ["contract_version", "evidence_id", "type", "verification_state", "provenance"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "evidence_id": {"type": "string", "minLength": 1},
    "type": {"type": "string", "minLength": 1},
    "verification_state": {"enum": ["VERIFIED", "ESTIMATED", "UNVERIFIED", "DISPUTED", "STALE"]},
    "provenance": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {"type": ["string", "null"]},
        "observed_at": {"type": ["string", "null"], "format": "date-time"},
        "collected_at": {"type": ["string", "null"], "format": "date-time"},
        "methodology": {"type": ["string", "null"]},
        "artifact_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "claims": {"type": "array", "items": {"type": "string"}},
    "trace_id": {"type": ["string", "null"]},
    "run_id": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
