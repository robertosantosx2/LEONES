{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leones.local/schemas/runtime-execution.v1.json",
  "title": "LEONES runtime-execution.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "execution_status",
    "selection",
    "runtime",
    "model",
    "artifact",
    "host",
    "workload",
    "protocol",
    "command",
    "observations",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "runtime-execution.v1"},
    "execution_id": {"type": "string", "minLength": 1},
    "execution_status": {"enum": ["planned", "started", "completed", "failed", "aborted"]},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_status", "selection_plan_hash"],
      "properties": {
        "selection_status": {"type": "string", "minLength": 1},
        "selection_plan_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "version", "backend", "entrypoint_kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "backend": {"type": "string", "minLength": 1},
        "entrypoint_kind": {"type": "string", "minLength": 1}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "quantization", "format"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "quantization": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1},
        "architecture": {"type": "string"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "size_bytes"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "os_version", "arch", "cpu", "ram_bytes"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "os_version": {"type": "string", "minLength": 1},
        "kernel": {"type": "string"},
        "arch": {"type": "string", "minLength": 1},
        "cpu": {"type": "string", "minLength": 1},
        "ram_bytes": {"type": "integer", "minimum": 0},
        "gpu": {"type": "array", "items": {"type": "string"}},
        "vram_bytes": {"type": "integer", "minimum": 0},
        "memory_bandwidth_gbps": {"type": "number", "minimum": 0}
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_id", "input_tokens_target", "output_tokens_target", "context_tokens", "concurrency"],
      "properties": {
        "prompt_id": {"type": "string", "minLength": 1},
        "input_tokens_target": {"type": "integer", "minimum": 0},
        "output_tokens_target": {"type": "integer", "minimum": 1},
        "context_tokens": {"type": "integer", "minimum": 1},
        "concurrency": {"type": "integer", "minimum": 1},
        "chat_template_id": {"type": "string"},
        "seed": {"type": "integer"},
        "decoding": {"type": "object"}
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "protocol_version", "warmup_runs", "measurement_runs", "aggregation", "frozen"],
      "properties": {
        "protocol_id": {"type": "string", "minLength": 1},
        "protocol_version": {"type": "string", "minLength": 1},
        "warmup_runs": {"type": "integer", "minimum": 0},
        "measurement_runs": {"type": "integer", "minimum": 1},
        "aggregation": {"enum": ["median", "mean", "both"]},
        "frozen": {"const": true}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "cwd": {"type": "string", "minLength": 1},
        "env_allowlist": {"type": "array", "items": {"type": "string"}}
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at", "exit_code", "stdout_sha256", "stderr_sha256"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "exit_code": {"type": "integer"},
        "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ttft_ms": {"type": "number", "minimum": 0},
        "tpot_ms": {"type": "number", "minimum": 0},
        "tokens_per_second": {"type": "number", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "peak_ram_bytes": {"type": "integer", "minimum": 0},
        "peak_vram_bytes": {"type": "integer", "minimum": 0},
        "power_watts": {"type": "number", "minimum": 0}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner_id", "runner_version", "recorded_at", "artifact_hash"],
      "properties": {
        "runner_id": {"type": "string", "minLength": 1},
        "runner_version": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date-time"},
        "artifact_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
