{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-benchmark-evidence.v1.1",
  "title": "LEONES Runtime Benchmark Evidence V1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "execution_id", "timestamp_start", "timestamp_end", "model", "protocol", "runtime", "hardware", "measurements", "summary", "process", "artifact"],
  "properties": {
    "schema": {"const": "runtime-benchmark-evidence.v1.1"},
    "execution_id": {"type": "string", "minLength": 8},
    "timestamp_start": {"type": "string", "format": "date-time"},
    "timestamp_end": {"type": "string", "format": "date-time"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "revision", "artifact", "quantization", "context_length"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "source": {"type": ["string", "null"]},
        "artifact": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
        "artifact_size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "quantization": {"type": "string", "minLength": 1},
        "context_length": {"type": "integer", "minimum": 1}
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_protocol_id", "measurement_scope", "context", "warmup_iterations", "measurement_iterations"],
      "properties": {
        "prompt_protocol_id": {"type": "string", "minLength": 1},
        "measurement_scope": {"enum": ["local_process_first_output", "resident_server_request", "hosted_api_request"]},
        "prompt": {"type": "string"},
        "prompt_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_token_limit": {"type": ["integer", "null"], "minimum": 1},
        "temperature": {"type": ["number", "null"]},
        "top_p": {"type": ["number", "null"]},
        "seed": {"type": ["integer", "null"]},
        "context": {"type": "integer", "minimum": 1},
        "warmup_iterations": {"type": "integer", "minimum": 0},
        "measurement_iterations": {"type": "integer", "minimum": 1}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "command"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "revision": {"type": ["string", "null"]},
        "backend": {"type": ["string", "null"]},
        "binary": {"type": ["string", "null"]},
        "binary_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "os", "kernel", "architecture", "cpu", "ram_total_mb"],
      "properties": {
        "host": {"type": "string"},
        "os": {"type": "string"},
        "kernel": {"type": "string"},
        "architecture": {"type": "string"},
        "cpu": {"type": "string"},
        "cpu_threads": {"type": ["integer", "null"], "minimum": 1},
        "physical_cores": {"type": ["integer", "null"], "minimum": 1},
        "ram_total_mb": {"type": ["number", "null"], "minimum": 0},
        "gpu": {"type": ["string", "null"]},
        "vram_total_mb": {"type": ["number", "null"], "minimum": 0},
        "storage": {"type": ["string", "null"]},
        "driver": {"type": ["string", "null"]}
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["iteration", "exit_code", "total_time_ms", "stdout", "stderr"],
        "properties": {
          "iteration": {"type": "integer", "minimum": 1},
          "ttft_ms": {"type": ["number", "null"], "minimum": 0},
          "first_output_ms": {"type": ["number", "null"], "minimum": 0},
          "generation_time_ms": {"type": ["number", "null"], "minimum": 0},
          "output_tokens": {"type": ["integer", "null"], "minimum": 0},
          "tokens_per_second": {"type": ["number", "null"], "minimum": 0},
          "total_time_ms": {"type": "number", "minimum": 0},
          "peak_memory_mb": {"type": ["number", "null"], "minimum": 0},
          "peak_vram_mb": {"type": ["number", "null"], "minimum": 0},
          "power_w": {"type": ["number", "null"], "minimum": 0},
          "exit_code": {"type": "integer"},
          "stdout": {"type": "string"},
          "stderr": {"type": "string"}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttft_ms": {"$ref": "#/$defs/stats"},
        "first_output_ms": {"$ref": "#/$defs/stats"},
        "generation_time_ms": {"$ref": "#/$defs/stats"},
        "output_tokens": {"$ref": "#/$defs/stats"},
        "tokens_per_second": {"$ref": "#/$defs/stats"},
        "total_time_ms": {"$ref": "#/$defs/stats"},
        "peak_memory_mb": {"$ref": "#/$defs/stats"},
        "peak_vram_mb": {"$ref": "#/$defs/stats"},
        "power_w": {"$ref": "#/$defs/stats"}
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "stdout", "stderr"],
      "properties": {
        "exit_code": {"type": "integer"},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "size": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean", "median", "min", "max"],
      "properties": {
        "mean": {"type": "number", "minimum": 0},
        "median": {"type": "number", "minimum": 0},
        "min": {"type": "number", "minimum": 0},
        "max": {"type": "number", "minimum": 0},
        "stdev": {"type": "number", "minimum": 0}
      }
    }
  }
}
