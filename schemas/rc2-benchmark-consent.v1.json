{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leones.local/schemas/rc2-benchmark-consent.v1.json",
  "title": "LEONES RC2 Benchmark Consent v1",
  "type": "object",
  "required": ["schema_version", "status", "benchmark", "execution_authorized"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["benchmark_declined", "benchmark_authorized", "benchmark_blocked", "benchmark_completed", "benchmark_failed"]},
    "benchmark": {
      "type": "object",
      "required": ["id", "version", "tasks"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "tasks": {"type": "array", "items": {"type": "string"}},
        "metric": {"type": ["string", "null"]},
        "estimated_duration_seconds": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": true
    },
    "execution_authorized": {"type": "boolean"},
    "consent_at": {"type": ["string", "null"]},
    "execution_id": {"type": ["string", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "benchmark_authorized"}}}, "then": {"properties": {"execution_authorized": {"const": true}}}},
    {"if": {"properties": {"status": {"enum": ["benchmark_declined", "benchmark_blocked"]}}}, "then": {"properties": {"execution_authorized": {"const": false}}}},
    {"if": {"properties": {"status": {"enum": ["benchmark_completed", "benchmark_failed"]}}}, "then": {"required": ["execution_id"]}}
  ],
  "additionalProperties": false
}
