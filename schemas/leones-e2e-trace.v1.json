{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LEONES E2E Trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "trace_id", "status", "stages"],
  "properties": {
    "schema": {"const": "leones-e2e-trace.v1"},
    "trace_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["planned", "measured", "published"]},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {"enum": ["hardware", "selection", "runtime", "execution", "measurement", "evidence", "decision", "validation", "promotion", "publication", "recommendation"]},
          "status": {"enum": ["pending", "complete", "skipped"]},
          "ref": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
