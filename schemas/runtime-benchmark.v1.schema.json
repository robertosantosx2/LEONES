{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robertosantosx2.github.io/LEONES/schemas/runtime-benchmark.v1.schema.json",
  "title": "LEONES runtime benchmark v1",
  "type": "object",
  "required": ["schema", "status", "runtime", "model", "task", "wall_seconds", "grader_pass"],
  "properties": {
    "schema": { "const": "runtime-benchmark.v1" },
    "status": { "enum": ["measured", "failed"] },
    "runtime": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "quantization": { "type": ["string", "null"] },
    "task": { "const": "A01" },
    "wall_seconds": { "type": "number", "minimum": 0 },
    "tokens_per_second": { "type": ["number", "null"], "minimum": 0 },
    "grader_pass": { "type": "boolean" },
    "executor_result_ref": { "type": "string" },
    "raw_executor_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": true
}
