# ODS / Strata — example env (skeleton for PR C in Osmantic/ODS)
# Merge into ODS .env / .env.example; do not commit secrets.

# STRATA_IMAGE=ods-strata:<pinned-tag-or-digest>
# BIND_ADDRESS=127.0.0.1
STRATA_PORT=8088

STRATA_FAMILY=
STRATA_MODEL=IQ2_XS
STRATA_CONTEXT=8192
STRATA_VISION=no
STRATA_KV=
STRATA_GPU=
STRATA_GPUS=
STRATA_LOW_RAM=auto

# STRATA_API_KEY=
# STRATA_REINSTALL=
STRATA_START_PERIOD=600s

# STRATA_CUDA_ARCHITECTURES=75;80;86;89;120
# STRATA_BUILD_VISION=1
