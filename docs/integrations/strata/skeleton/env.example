# ODS / Strata — example env (skeleton for PR C)
# Merge relevant keys into ODS .env / .env.example; do not commit secrets.

# --- Image / pin ---
# STRATA_IMAGE=ods-strata:<pinned-tag-or-digest>

# --- Host publish (loopback recommended) ---
# BIND_ADDRESS=127.0.0.1
STRATA_PORT=8088

# --- Model / runtime (passed into container) ---
STRATA_FAMILY=
STRATA_MODEL=IQ2_XS
STRATA_CONTEXT=8192
STRATA_VISION=no
STRATA_KV=
STRATA_GPU=
STRATA_GPUS=
STRATA_LOW_RAM=auto

# Required if binding beyond loopback
# STRATA_API_KEY=

# Set to 1 to re-run model setup after changing MODEL/FAMILY/etc.
# STRATA_REINSTALL=

# Health start_period (first load / download can exceed several minutes)
STRATA_START_PERIOD=600s

# Optional build args when building from upstream Dockerfile
# STRATA_CUDA_ARCHITECTURES=75;80;86;89;120
# STRATA_BUILD_VISION=1
