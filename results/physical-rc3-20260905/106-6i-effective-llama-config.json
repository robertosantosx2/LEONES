{
  "image": "ghcr.io/ggml-org/llama.cpp:server-b8248",
  "command": [
    "--model",
    "/models/Qwen3.5-2B-Q4_K_M.gguf",
    "--host",
    "0.0.0.0",
    "--port",
    "8080",
    "--n-gpu-layers",
    "0",
    "--ctx-size",
    "4096",
    "--batch-size",
    "64",
    "--ubatch-size",
    "32",
    "--threads",
    "4",
    "--threads-batch",
    "4",
    "--parallel",
    "1",
    "--no-cache-prompt",
    "--cache-ram",
    "256",
    "--metrics"
  ],
  "environment": {
    "LLAMA_ARG_CACHE_TYPE_K": "f16",
    "LLAMA_ARG_CACHE_TYPE_V": "f16",
    "LLAMA_ARG_CHECKPOINT_EVERY_N_TOKENS": null,
    "LLAMA_ARG_FLASH_ATTN": "auto",
    "LLAMA_ARG_NO_CACHE_PROMPT": null,
    "LLAMA_ARG_N_CPU_MOE": null,
    "LLAMA_ARG_REASONING": "off",
    "LLAMA_ARG_SPEC_DRAFT_N_MAX": null,
    "LLAMA_ARG_SPEC_TYPE": null
  },
  "mem_limit": null
}
