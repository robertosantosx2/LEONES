#version 460
layout(local_size_x = 256) in;
#include "common.glsl"
// Workgroup = row. out[r] = rmsnorm(x[r]) * w; with q not null, out is also quantized as quant_xq does. With step not
// null, out is then rotated as rope_neox does (row r = a head of token r / per). With res not null, x += res first.
// With kc not null, out and v (rows of n) are then stored as kv_store does.
layout(push_constant) uniform P { F32 x; F32 w; F32 o; U32 q; uint xs; uint os; uint n; float eps; I32 step; double ts; uint per; uint n_rot; F32 res;
                                  F32 v; U16 kc; U16 vc; } p;
void main() {
    uint r = gl_WorkGroupID.x, xo = r * p.xs, oo = r * p.os, h = 0;
    float s = 0.0;
    // Four loads in flight per step (the sum keeps its order).
    uint i = gl_LocalInvocationID.x;
    if (uint64_t(p.res) != 0) {
        // Each invocation reads back only its own x below; quant_x reads others', hence the buffer barrier.
        for (; i + 768 < p.n; i += 1024) {
            float v[4];
            [[unroll]] for (uint j = 0; j < 4; j++) v[j] = p.x.v[xo + i + 256 * j] + p.res.v[xo + i + 256 * j];
            [[unroll]] for (uint j = 0; j < 4; j++) { p.x.v[xo + i + 256 * j] = v[j]; s += v[j] * v[j]; }
        }
        for (; i < p.n; i += 256) { float a = p.x.v[xo + i] + p.res.v[xo + i]; p.x.v[xo + i] = a; s += a * a; }
        memoryBarrierBuffer();
    }
    for (; i + 768 < p.n; i += 1024) {
        float a = p.x.v[xo + i], b = p.x.v[xo + i + 256], c = p.x.v[xo + i + 512], e = p.x.v[xo + i + 768];
        s += a * a; s += b * b; s += c * c; s += e * e;
    }
    for (; i < p.n; i += 256) s += p.x.v[xo + i] * p.x.v[xo + i];
    float sc = fdiv(1.0, sqrt_(fdiv(block_sum(s), float(p.n)) + p.eps));
    if (uint64_t(p.step) != 0) {
        h = p.n_rot / 2;
        double pos = double(p.step.v[0] + int(r / p.per));
        for (uint i = gl_LocalInvocationID.x; i < h; i += 256) {
            float sn, cs, a = p.x.v[xo + i] * sc * p.w.v[i], b = p.x.v[xo + i + h] * sc * p.w.v[i + h];
            rope_cs(pos, p.ts, i, sn, cs);
            p.o.v[oo + i] = a * cs - b * sn;
            p.o.v[oo + i + h] = a * sn + b * cs;
        }
        h *= 2;
    }
    // With q, quant_x stores out from the values it quantizes (same products), so x is read once.
    if (uint64_t(p.q) != 0)
        quant_x(p.x, xo, p.n, p.w, sc, F32(0ul), p.q, r * p.n / 4, F32(uint64_t(p.q) + gl_NumWorkGroups.x * p.n), r * (p.n / 32), p.o, oo);
    else {
        for (i = h + gl_LocalInvocationID.x; i + 768 < p.n; i += 1024) {
            float v[4];  // loaded before any store, which may alias x
            [[unroll]] for (uint j = 0; j < 4; j++) v[j] = p.x.v[xo + i + 256 * j] * sc * p.w.v[i + 256 * j];
            [[unroll]] for (uint j = 0; j < 4; j++) p.o.v[oo + i + 256 * j] = v[j];
        }
        for (; i < p.n; i += 256) p.o.v[oo + i] = p.x.v[xo + i] * sc * p.w.v[i];
    }
    if (uint64_t(p.kc) != 0) {
        memoryBarrierBuffer();
        barrier();
        uint e = (uint(p.step.v[0]) * p.per + r) * p.n;
        for (i = gl_LocalInvocationID.x; i < p.n; i += 256) {
            kv_put(p.kc, e + i, p.n, p.o.v[oo + i]);
            kv_put(p.vc, e + i, p.n, p.v.v[r * p.n + i]);
        }
    }
}
