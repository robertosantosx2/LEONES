#version 460
// Expert GEMV (CUDA moe_gemv for integer types): workgroup y = slot k, z = matrix (z = 1: weights + w2, output + y2
// bytes). Slot k multiplies expert ids[k] (skipped when negative; its weights at w + ids[k] * stride) by token k / xg
// of x pre-quantized by quant_xq at xq (ntok rows), into y + k * rows. Subgroup w of a workgroup covers rows w, w + 8, ..
// (rpw of them; kernels.cu's rows per warp), so a workgroup covers 8 * rpw rows.
layout(local_size_x = 256) in;
#include "common.glsl"
#define SHARED_TABLES
#include "deq.glsl"
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_control_flow_attributes : require

layout(push_constant) uniform P { U8 w; I32 ids; U32 xq; F32 y; uint64_t stride; uint64_t w2; uint64_t y2; uint rows; uint cols; uint xg; uint ntok; uint rpw; } p;

void sb_step(U8 w, F32 xd, uint row, uint lane, uint t, uint s, inout precise float acc) {
    uint lo, hi; float d, m;
    qw(w, row * rowb(p.cols) + s * SBB, lane, lo, hi, d, m);
    uint o = (t * p.cols + s * 256) / 4 + lane * 2, a = p.xq.v[o], c = p.xq.v[o + 1];
    int dot = dotPacked4x8EXT(int(lo), int(a)) + dotPacked4x8EXT(int(hi), int(c));
    int sx = dotPacked4x8EXT(0x01010101, int(a)) + dotPacked4x8EXT(0x01010101, int(c));
    float dx = xd.v[(t * p.cols + s * 256) / 32 + (lane >> 2)];
    acc = fma(d * dx, float(dot), acc);
    if (MIN) acc = fma(-(m * dx), float(sx), acc);  // types with a min
}

void main() {
    uint k = gl_WorkGroupID.y, lane = LANE;
    int e = p.ids.v[k];
    if (e < 0) return;  // the whole workgroup
    load_tables();
    U8 w = U8(uint64_t(p.w) + uint64_t(e) * p.stride + gl_WorkGroupID.z * p.w2);
    F32 y = F32(uint64_t(p.y) + gl_WorkGroupID.z * p.y2);
    F32 xd = F32(uint64_t(p.xq) + p.ntok * p.cols);
    uint t = k / p.xg, nsb = p.cols >> 8, r0 = gl_WorkGroupID.x * 8 * p.rpw, r1 = min(p.rows, r0 + 8 * p.rpw);
    for (uint row = r0 + WARP; row < r1; row += 8) {
        precise float acc = 0.0;
        // Four super-blocks per iteration so their loads overlap (kernels.cu: unroll 4); the sums keep their order.
        uint s = 0;
        for (; s + 4 <= nsb; s += 4) [[unroll]] for (uint j = 0; j < 4; j++) sb_step(w, xd, row, lane, t, s + j, acc);
        for (; s < nsb; s++) sb_step(w, xd, row, lane, t, s, acc);
        if ((p.cols & 255) > lane * 8) sb_step(w, xd, row, lane, t, nsb, acc);  // partial last super-block
        acc = warp_sum(acc);
        if (lane == 0) y.v[k * p.rows + row] = acc;
    }
}
