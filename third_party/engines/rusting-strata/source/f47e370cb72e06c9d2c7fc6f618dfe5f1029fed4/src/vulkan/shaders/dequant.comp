#version 460
// Weight rows of cols values of type T to f32: one workgroup per row (CUDA dequant_*).
layout(local_size_x = 256) in;
#include "common.glsl"
#include "deq.glsl"

layout(push_constant) uniform P { U8 w; F32 o; uint cols; } p;

void main() {
    uint row = gl_WorkGroupID.x;
    float v[8];
    for (uint s = gl_LocalInvocationID.x; s < p.cols / 8; s += 256) {
        deq8(p.w, row * rowb(p.cols) + (s >> 5) * SBB, s & 31, v);
        uint o = row * p.cols + s * 8;
        for (uint i = 0; i < 8; i++) p.o.v[o + i] = v[i];
    }
}
