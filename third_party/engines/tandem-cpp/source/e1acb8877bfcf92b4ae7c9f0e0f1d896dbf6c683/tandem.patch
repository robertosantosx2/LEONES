+    bool prefill_plan(ggml_backend_t backend, const ggml_tensor * w, const ggml_tensor * ids_t, std::vector<int32_t> & ids_data, std::vector<bool> & used) {
+        if (!pf) {
+            return false;
+        }
+        const auto it = bindings.find(w);
