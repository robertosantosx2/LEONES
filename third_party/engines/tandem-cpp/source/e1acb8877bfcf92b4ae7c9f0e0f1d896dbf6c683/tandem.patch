+        if (sz > 0 && !embd_override) {
+            gguf_init_params gp = { /* .no_alloc = */ true, /* .ctx = */ nullptr };
+            ggml_context * meta = nullptr;
+            gp.ctx = &meta;
+            gguf_context_ptr g(gguf_init_from_file(dft.mparams.path.c_str(), gp));
+            const ggml_tensor * te = meta ? ggml_get_tensor(meta, "token_embd.weight") : nullptr;
+            if (te != nullptr && ggml_nbytes(te) < sz) {
