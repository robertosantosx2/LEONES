+        w ? (const float *) w->data : nullptr, n_ids, x ? (int) ggml_nelements(x) : 0, n_ids/n_used, n_used, db->slots_cap, db->max_fill, d);
+    static const int n_blocks = [] {
+        const char * s = getenv("GGML_CUDA_MOE_DB_BLOCKS");
+        return s ? std::max(1, atoi(s)) : 256;
+    }();
+    k_moe_db_upload<<<n_blocks, 256, 0, stream>>>((const uint32_t *) (d + ((n_ids + 1) & ~1)));
