+        if (buf == nullptr || buf->buft != ggml_backend_cuda_buffer_type(ctx->device) || size[i] > UINT32_MAX) {
+            return false;
+        }
+        total += (size[i] + 15) & ~(size_t) 15;
+    }
+    if (n <= 0 || total > GGML_CUDA_PACK_CAP) {
+        return false;
