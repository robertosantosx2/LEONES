+            const double wait_us = ((volatile uint32_t *) lp.pf_flag->data)[2]/1000.0;
+            const double c = (double) lp.t_job/pf_prev_ncpu;
+            const double g = std::max(0.0, (double) (t0 - pf_prev_t0) - wait_us)/std::max<int64_t>(pf_prev_ngpu, 1);
