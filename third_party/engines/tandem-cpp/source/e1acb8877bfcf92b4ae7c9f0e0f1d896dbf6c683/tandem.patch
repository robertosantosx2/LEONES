+        }                                                                                                                  \
+    }                                                                                                                      \
+    for (int r = 0; r < 4; ++r) {                                                                                          \
+        __m128 v = _mm_add_ps(_mm256_castps256_ps128(acc[r]), _mm256_extractf128_ps(acc[r], 1));                           \
+        v = _mm_hadd_ps(v, v);                                                                                             \
+        v = _mm_hadd_ps(v, v);                                                                                             \
+        out[r] = _mm_cvtss_f32(v) - corr[r];                                                                               \
+    }
