+        off += (size[i] + 15) & ~(size_t) 15;
+    }
+    cudaStream_t stream = ctx->stream();
+    CUDA_CHECK(cudaMemcpyAsync(ctx->pack_dev[k], h, total, cudaMemcpyHostToDevice, stream));
