+    }
+    if (x != nullptr) {
+        if ((n_x & 3) == 0) {
+            for (int i = tid; i < n_x/4; i += blockDim.x) {
+                ((float4 *) h_x)[i] = ((const float4 *) x)[i];
+            }
+        } else {
+            for (int i = tid; i < n_x; i += blockDim.x) {
