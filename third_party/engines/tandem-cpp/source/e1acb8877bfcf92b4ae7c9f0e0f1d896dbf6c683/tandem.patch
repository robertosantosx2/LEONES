+        vdb->n_used = n_used;
+        vdb->hyb    = x != nullptr;
+        __threadfence_system();
+        vdb->req = r;
+        __threadfence_system();
+        uint64_t t0, t;
+        asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t0));
+        t = t0;
+        ok = 1;
+        while (vdb->ack != r) {
+            __nanosleep(64);
+            asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t));
+            if (t - t0 > 2000000000ull) {
