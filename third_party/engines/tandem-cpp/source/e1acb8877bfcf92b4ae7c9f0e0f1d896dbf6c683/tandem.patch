+    hc_mix_a<NT, RPB><<<ga, HCF_A_THREADS, 0, st>>>(pp, (float *) x->data, (const float *) mul->src[1]->data, \
+        (const nv_bfloat16 *) wd->data, wi_d, rs_tmp.get(), lo_d, inj_d, (int) n_embd, (int) R, n_rows_a, eps, sx_t, slo_t, sinj_t)
