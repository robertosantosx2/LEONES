+
+        cg.buf.reset(ggml_backend_alloc_ctx_tensors(c, cpu_backend.get()));
+        GGML_ASSERT(cg.buf);
+        cg.act   = l.act;
+        cg.limit = l.limit;
+        return cg;
+    }
