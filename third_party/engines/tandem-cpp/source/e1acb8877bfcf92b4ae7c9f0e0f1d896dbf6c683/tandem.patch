+static __global__ void k_host_add_wait(volatile uint32_t * flag) {
+    const uint32_t seen = flag[1];
+    uint64_t t0, t;
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t0));
+    t = t0;
+    uint32_t v;
+    while ((v = flag[0]) == seen) {
