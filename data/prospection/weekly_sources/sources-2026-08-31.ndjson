{"type": "software", "name": "jenr8ed_code/ActivityPubExtension4AgenticDelegation.and.HITL.Verification", "url": "https://codeberg.org/jenr8ed_code/ActivityPubExtension4AgenticDelegation.and.HITL.Verification", "description": "As autonomous AI agents increasingly interact with social networks, distinguishing between purely automated bot spam and authorized, agent-drafted but human-approved content is critical. This FEP proposes an extension to the ActivityStreams Create and Note objects to include standardized metadata for \"Agentic Delegation.\" It introduces a generator and approvalGate property to explicitly declare when a payload was constructed by an LLM or multi-agent system but cryptographically or explicitly authorized by a human principal (Human-in-the-Loop). This allows Fediverse instances to filter, badge, or federate agent-assisted content securely without resorting to blanket bot bans, preserving server health while enabling next-generation omnichannel automation.", "source": "codeberg", "source_url": "https://codeberg.org", "evidence_url": "https://codeberg.org/jenr8ed_code/ActivityPubExtension4AgenticDelegation.and.HITL.Verification", "license": "", "license_status": "unvalidated", "observed_at": "2026-08-31T11:40:46.127651+00:00", "query": "LLM", "publication_status": "discovered", "provenance": {"adapter": "forgejo", "source_id": "codeberg"}}
