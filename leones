#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Always operate on the controlling terminal, not on stdin alone. This matters
# when the runner is launched from wrappers/pipes and guarantees that normal
# input echo is restored before prompts and after the runner exits.
restore_tty() {
    if [[ -t 0 ]]; then
        stty echo echonl 2>/dev/null || true
    fi
    if [[ -c /dev/tty ]]; then
        stty -F /dev/tty echo echonl 2>/dev/null || true
    fi
}

restore_tty
trap restore_tty EXIT INT TERM

# RC4 is the default operator path. RC2 remains explicitly reachable for
# historical compatibility and regression work.
if [[ "${1:-}" == "--rc2" ]]; then
    shift
    set +e
    python3 "$ROOT/scripts/rc2_wizard.py" "$@"
    rc=$?
    set -e
else
    set +e
    python3 "$ROOT/scripts/rc4_runner.py" "$@"
    rc=$?
    set -e
fi

restore_tty
exit "$rc"
