#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Always operate on the controlling terminal, not on stdin alone. This matters
# when the wizard is launched from wrappers/pipes and guarantees that normal
# input echo is restored before the first prompt and after the wizard exits.
restore_tty() {
    if [[ -t 0 ]]; then
        stty echo echonl 2>/dev/null || true
    fi
    if [[ -c /dev/tty ]]; then
        stty -F /dev/tty echo echonl 2>/dev/null || true
    fi
}

restore_tty
trap restore_tty EXIT INT TERM

set +e
python3 "$ROOT/scripts/rc2_wizard.py" "$@"
rc=$?
set -e
restore_tty
exit "$rc"
